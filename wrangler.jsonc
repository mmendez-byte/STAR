{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sullairgo-star",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    // SHA-256 de la contraseña de acceso. Para cambiarla: npm run hash -- "NuevaContraseña"
    "PASSWORD_HASH": "41d37eba3025c47f5586f470b2398ce170e7ccdb53adbdc0c4708100c4061102",
    // SHA-256 de la clave del link de administración (/admin?clave=…). Para cambiarla: npm run hash -- "NuevaClave"
    "ADMIN_TOKEN_HASH": "7a1896ea7d722b240933490b668e9deded078c39a7adb1f13a2212388be509eb"
  },
  // Comentarios de los testers (tabla en migrations/).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sullairgo-star",
      "database_id": "0f295979-da35-43a5-8d3e-83e956a3f059",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
